    "\n",
    "reg1 = RandomForestRegressor(n_estimators=100, random_state=0)\n",
    "reg2 = LinearRegression()\n",
    "reg3 =lm.SGDRegressor(max_iter=1000)\n",
    "X1 = X1.ravel()\n",
