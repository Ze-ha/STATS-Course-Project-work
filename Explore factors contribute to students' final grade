    "    X3.reshape(-1, 1),\n",
    "    (X1*X1).reshape(-1,1),\n",
    "    (X3*X3).reshape(-1,1),\n",
    "   (X1 * X3).reshape(-1, 1),\n",
    "), axis=1)\n",
    "Xa_scaled = scaler.fit_transform(Xa)\n",
